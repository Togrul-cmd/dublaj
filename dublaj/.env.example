# ============================================
# Dublaj — Video Dubbing Pipeline Configuration (.env TEMPLATE)
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# --- General ---
APP_HOST=0.0.0.0
APP_PORT=8000
TEMP_DIR=./tmp
OUTPUT_DIR=./output

# --- Whisper Service ---
WHISPER_BASE_URL=http://localhost:8100
WHISPER_ENDPOINT=/v1/audio/transcriptions

# --- Translation Model ---
# Options: gemini, minimax, llamacpp, mimo
TRANSLATION_PROVIDER=llamacpp
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
TRANSLATION_MODEL=gemini-2.0-flash

# --- MiniMax (if TRANSLATION_PROVIDER=minimax) ---
MINIMAX_API_KEY=YOUR_MINIMAX_API_KEY_HERE
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7-highspeed

# --- llama.cpp (if TRANSLATION_PROVIDER=llamacpp) ---
LLAMACPP_BASE_URL=http://localhost:8600
LLAMACPP_MODEL=gemma-e4b
THINKING_ENABLED=true

# --- MiMo (if TRANSLATION_PROVIDER=mimo) ---
MIMO_API_KEY=YOUR_MIMO_API_KEY_HERE
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# --- TTS Settings ---
TTS_PROVIDER=omnivoice
OMNIVOICE_URL=http://localhost:8200
OMNIVOICE_VOICE=male

# --- Audio Separator (windowed-roformer, новая быстрая модель) ---
AUDIO_SEPARATOR_URL=http://localhost:8310
USE_VOICE_SEPARATION=True

# --- Seed-VC V1 (Voice Converter) ---
SEEDVC_URL=http://localhost:8700
SEEDVC_MAX_PARALLEL=3

# --- PyAnnote Speaker Diarization ---
PYANNOTE_URL=http://localhost:8500

# --- FFmpeg ---
FFMPEG_PATH=ffmpeg

# --- HuggingFace (for PyAnnote model download) ---
HF_TOKEN=YOUR_HF_TOKEN_HERE

# ============================================
# How to get API keys:
#   Gemini:      https://aistudio.google.com/apikey
#   MiniMax:     https://www.minimaxi.com
#   HuggingFace: https://huggingface.co/settings/tokens
#   MiMo:        https://xiaomimimo.com
# ============================================
